        {
          "label": "q15_18",
          "model": "Qwen/Qwen1.5-1.8B"
        }
      ],
      "subsets": [
        "artifacts/subsets/v2_subset_s11.json",
        "artifacts/subsets/v2_subset_s22.json",
        "artifacts/subsets/v2_subset_s1234.json"
      ],
      "generations_dir": "artifacts/reference_solutions"
    },
    "sequence_kd_fullD": {
      "kind": "sequence_kd",
      "prefix": "seqkdF",
      "description": "sequence-level KD over the whole student half, not a tenth of it",
      "students": [
        {
          "label": "q15_18",
          "model": "Qwen/Qwen1.5-1.8B"
        }
      ],
      "subsets": [
        {
          "path": "artifacts/subsets/subset_FULL.json",
