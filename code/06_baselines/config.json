      ],
      "generations_dir": "artifacts/teacher_solutions_fullD",
      "generate_batch_size": 24
    },
    "rewrite_math_fullD": {
      "kind": "sequence_kd",
      "prefix": "seqkdFM",
      "description": "the MATH teacher rewrites the whole student half, so the same split can be studied on its text",
      "dataset": "math",
      "teacher": "runs/teacher_math",
      "students": [
        {
          "label": "q2_15",
          "model": "Qwen/Qwen2-1.5B"
        }
      ],
      "subsets": [
        {
          "path": "artifacts/subsets/subset_FULL_math.json",
